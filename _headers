# Seguridad básica del sitio estático — Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Evitar que Safari conserve el HTML y los módulos antiguos del catálogo.
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/scripts/*
  Cache-Control: no-cache, must-revalidate
/styles/*
  Cache-Control: no-cache, must-revalidate
